---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import "../styles/global.css";
import { profile } from "../data/profile";
import portrait from "../../public/images/dmitry-fadeev.png";

const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const timelineExperience = experience.filter(
  (item) => !["Pixel Runner", "WID - цифровой гардероб"].includes(item.data.company),
);

const projectsWithPrimaryLinks = projects.map((project) => ({
  project,
  primaryHref: project.data.titleHref ?? project.data.links[0]?.href,
}));
const keepShortWords = (value: string) =>
  value.replace(/(^|\s)([A-Za-zА-Яа-яЁё]{1,2})\s+(?=\S)/gu, "$1$2\u00A0");
const cooperationSubject = encodeURIComponent("Предложение сотрудничества");
const contactFormEndpoint = `https://formsubmit.co/ajax/${profile.email}`;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const privacyUrl = `${basePath}privacy/`;
const consentUrl = `${basePath}consent/`;
const diplomaUrl = `${basePath}${profile.education.diplomaUrl.replace(/^\//, "")}`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Премиальное портфолио Дмитрия Фадеева, Project Manager для digital, B2B и fashion-tech проектов."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{profile.name} - {profile.role}</title>
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem("theme") === "light") {
            document.documentElement.dataset.theme = "light";
          }
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top">
        <span class="brand-full">Dmitriy Web</span>
        <span class="brand-short" aria-hidden="true">ДФ</span>
      </a>
      <nav class="nav" aria-label="Основная навигация">
        <a href="#education" aria-label="Диплом"><span class="nav-label">Диплом</span><span class="nav-icon" aria-hidden="true">Диплом</span></a>
        <a href="#projects" aria-label="Опыт и кейсы"><span class="nav-label">Опыт</span><span class="nav-icon" aria-hidden="true">Опыт</span></a>
        <a href="#artifacts" aria-label="Артефакты"><span class="nav-label">Артефакты</span><span class="nav-icon" aria-hidden="true">Артефакты</span></a>
        <a href="#pet-projects" aria-label="Мои проекты"><span class="nav-label">Мои проекты</span><span class="nav-icon" aria-hidden="true">Мои проекты</span></a>
        <a href="#contact" aria-label="Контакты"><span class="nav-label">Контакты</span><span class="nav-icon" aria-hidden="true">Связь</span></a>
      </nav>
      <button class="theme-action" type="button" data-theme-toggle aria-label="Включить светлую тему" aria-pressed="false">
        <span class="theme-icon theme-icon-light" aria-hidden="true">☾</span>
        <span class="theme-icon theme-icon-dark" aria-hidden="true">✹</span>
      </button>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow hero-eyebrow">{profile.name} / {profile.role}</p>
          <h1 id="hero-title">Управляю digital-проектами без хаоса</h1>
          <p class="lead">{keepShortWords(profile.headline)}</p>
          <p class="hero-summary">{keepShortWords(profile.summary)}</p>
          <div class="actions" aria-label="Основные действия">
            <button class="button primary" type="button" data-feedback-trigger>Обсудить проект</button>
          </div>
        </div>

        <figure class="hero-media" aria-label="Портрет Дмитрия Фадеева">
          <div class="portrait-frame">
            <Image
              src={portrait}
              alt="Дмитрий Фадеев"
              widths={[480, 720, 960]}
              sizes="(max-width: 860px) 82vw, 40vw"
              loading="eager"
            />
          </div>
        </figure>
      </section>

      <section class="section split-section education-section" id="education" aria-labelledby="education-title">
        <div class="section-heading">
          <p class="eyebrow">Диплом</p>
          <h2 id="education-title">Яндекс Практикум по управлению IT-проектами</h2>
        </div>
        <div class="education-panel education-panel-compact">
          <div>
            <h3>{profile.education.title}</h3>
            <p>{keepShortWords(`${profile.education.program}. ${profile.education.qualification}, ${profile.education.hours}.`)}</p>
            <p>{keepShortWords(profile.education.quote)}</p>
          </div>
          <a class="button secondary diploma-link" href={diplomaUrl} target="_blank" rel="noreferrer">Смотреть диплом</a>
        </div>
      </section>

      <section class="section projects-section" id="projects" aria-labelledby="projects-title">
        <div class="section-heading">
          <p class="eyebrow">Опыт и кейсы</p>
          <h2 id="projects-title">Digital, B2B и fashion-tech проекты</h2>
          <div class="compact-skills" aria-label="Ключевые навыки">
            {profile.skills.slice(0, 10).map((skill) => <span>{skill}</span>)}
          </div>
        </div>
        <button class="mobile-disclosure-toggle" type="button" data-mobile-toggle="experience" aria-controls="mobile-experience-panel" aria-expanded="false">
          <span>Опыт</span>
          <span aria-hidden="true">Открыть</span>
        </button>
        <div class="mobile-disclosure-panel" id="mobile-experience-panel" data-mobile-panel="experience">
          <h3 class="project-section-label">Опыт</h3>
          <div class="project-grid project-experience">
          {
            timelineExperience.map((item) => (
              <article class="project-card experience-card">
                <div class="project-topline">
                  <span>Experience</span>
                  <span>{item.data.role}</span>
                </div>
                <h3>
                  {item.data.companyLinks ? (
                    <span class="company-links">
                      {item.data.companyLinks.map((link, index) => (
                        <>
                          {index > 0 && <span class="company-separator">/</span>}
                          <a class="title-link" href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
                        </>
                      ))}
                    </span>
                  ) : item.data.url ? (
                    <a href={item.data.url} target="_blank" rel="noreferrer">{item.data.company}</a>
                  ) : (
                    item.data.company
                  )}
                </h3>
                <p>{keepShortWords(item.body ?? "")}</p>
                <ul>
                  {item.data.highlights.map((highlight) => <li>{keepShortWords(highlight)}</li>)}
                </ul>
              </article>
            ))
          }
          </div>
        </div>
        <button class="mobile-disclosure-toggle" type="button" data-mobile-toggle="cases" aria-controls="mobile-cases-panel" aria-expanded="false">
          <span>Кейсы</span>
          <span aria-hidden="true">Открыть</span>
        </button>
        <div class="mobile-disclosure-panel" id="mobile-cases-panel" data-mobile-panel="cases">
          <h3 class="project-section-label">Кейсы</h3>
          <div class="project-grid">
          {
            projectsWithPrimaryLinks.map(({ project, primaryHref }) => (
              <article class="project-card">
                <div class="project-topline">
                  <span>{project.data.category}</span>
                  {project.data.role && <span>{project.data.role}</span>}
                </div>
                <h3>
                  {primaryHref ? (
                    <a class="title-link" href={primaryHref} target="_blank" rel="noreferrer">
                      {project.data.title}
                    </a>
                  ) : (
                    project.data.title
                  )}
                </h3>
                <p>{keepShortWords(project.body ?? "")}</p>
                <ul>
                  {project.data.outcomes.map((outcome) => <li>{keepShortWords(outcome)}</li>)}
                </ul>
                {project.data.stack.length > 0 && (
                  <div class="tags" aria-label={`Технологии и инструменты проекта ${project.data.title}`}>
                    {project.data.stack.map((tag) => <span>{tag}</span>)}
                  </div>
                )}
              </article>
            ))
          }
          </div>
        </div>
      </section>

      <section class="section artifacts-section" id="artifacts" aria-labelledby="artifacts-title">
        <div class="section-heading">
          <p class="eyebrow">PM documentation</p>
          <h2 id="artifacts-title">Проектные артефакты</h2>
        </div>
        <button class="mobile-disclosure-toggle" type="button" data-mobile-toggle="artifacts" aria-controls="mobile-artifacts-panel" aria-expanded="false">
          <span>Проектные артефакты</span>
          <span aria-hidden="true">Открыть</span>
        </button>
        <div class="artifacts-panel mobile-disclosure-panel" id="mobile-artifacts-panel" data-mobile-panel="artifacts">
          <div class="artifact-groups">
            {
              profile.artifacts.featuredGroups.map((group) => (
                <article class="artifact-group">
                  <div class="artifact-group-head">
                    <h3>{group.title}</h3>
                  </div>
                  <p>{keepShortWords(group.text)}</p>
                  <div class="artifact-links" aria-label={`Артефакты: ${group.title}`}>
                    {group.links.map((link) => (
                      <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
                    ))}
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section github-section" id="pet-projects" aria-labelledby="github-title">
        <div class="section-heading">
          <p class="eyebrow">GitHub</p>
          <h2 id="github-title">Мои проекты</h2>
        </div>
        <button class="mobile-disclosure-toggle" type="button" data-mobile-toggle="pet-projects" aria-controls="mobile-pet-projects-panel" aria-expanded="false">
          <span>Пет-проекты</span>
          <span aria-hidden="true">Открыть</span>
        </button>
        <div class="github-panel mobile-disclosure-panel" id="mobile-pet-projects-panel" data-mobile-panel="pet-projects">
          <p>{keepShortWords(profile.github.note)}</p>
          <div class="repo-actions" aria-label="Публичные репозитории GitHub">
            {
              profile.github.repos.map((repo) => (
                <a class="repo-button" href={repo.href} target="_blank" rel="noreferrer">
                  <span>{repo.name}</span>
                  <small>{keepShortWords(repo.description)}</small>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <footer class="contact" id="contact" aria-labelledby="contact-title">
        <div class="contact-copy">
          <p class="eyebrow">Контакты</p>
          <h2 id="contact-title">Готов обсудить digital или IT-проект</h2>
          <div class="contact-actions">
            <a href={`mailto:${profile.email}?subject=${cooperationSubject}`}>Написать на email</a>
            <a href={profile.vk} target="_blank" rel="noreferrer">Написать в VK</a>
            <a href={profile.github.publicRepos} target="_blank" rel="noreferrer">GitHub</a>
          </div>
        </div>
        <form class="feedback-form contact-form" data-feedback-form data-form-endpoint={contactFormEndpoint} novalidate>
          <div class="feedback-head">
            <div>
              <p class="eyebrow">Форма связи</p>
              <h2>Напишите коротко, что вас заинтересовало</h2>
              <p class="feedback-subtitle">{keepShortWords("Я свяжусь с вами в течение 1 часа.")}</p>
            </div>
          </div>

          <label>
            <span>Имя</span>
            <input name="name" type="text" autocomplete="name" minlength="2" required placeholder="Как к вам обращаться" />
          </label>

          <label>
            <span>Почта</span>
            <input name="contact" type="email" autocomplete="email" required placeholder="email@example.com" />
          </label>

          <label>
            <span>Тема обращения</span>
            <input name="topic" type="text" minlength="10" required placeholder="Не менее 10 символов" />
          </label>

          <label class="consent-check">
            <input name="consent" type="checkbox" required />
            <span>
              Согласен с <a href={privacyUrl} target="_blank">политикой конфиденциальности</a> и <a href={consentUrl} target="_blank">обработкой персональных данных</a>.
            </span>
          </label>

          <p class="form-error" data-feedback-error hidden>Проверьте поля: имя - буквы и пробелы, почта - с @, тема - от 10 символов, согласие - отмечено.</p>
          <p class="form-success" data-feedback-success hidden>Спасибо, сообщение отправлено. Я свяжусь с вами в течение 1 часа.</p>

          <button class="button primary form-submit" type="submit">Отправить</button>
        </form>
        <div class="legal-links" aria-label="Юридическая информация">
          <a href={privacyUrl}>Политика конфиденциальности</a>
          <a href={consentUrl}>Согласие на обработку данных</a>
        </div>
      </footer>
    </main>

    <dialog class="feedback-dialog" id="feedbackDialog" aria-labelledby="feedbackTitle">
      <form class="feedback-form" id="feedbackForm" method="dialog" data-feedback-form data-form-endpoint={contactFormEndpoint} novalidate>
        <div class="feedback-head">
          <div>
            <p class="eyebrow">Обратная связь</p>
            <h2 id="feedbackTitle">Коротко опишите запрос</h2>
          </div>
          <button class="dialog-close" type="button" data-feedback-close aria-label="Закрыть форму">×</button>
        </div>

          <label>
            <span>Имя</span>
            <input name="name" type="text" autocomplete="name" minlength="2" required placeholder="Как к вам обращаться" />
          </label>

          <label>
            <span>Почта</span>
            <input name="contact" type="email" autocomplete="email" required placeholder="email@example.com" />
          </label>

        <label>
          <span>Тема обращения</span>
          <input name="topic" type="text" minlength="10" required placeholder="Не менее 10 символов" />
        </label>

        <label class="consent-check">
          <input name="consent" type="checkbox" required />
          <span>
            Согласен с <a href={privacyUrl} target="_blank">политикой конфиденциальности</a> и <a href={consentUrl} target="_blank">обработкой персональных данных</a>.
          </span>
        </label>

        <p class="form-error" data-feedback-error hidden>Проверьте поля: имя - буквы и пробелы, почта - с @, тема - от 10 символов, согласие - отмечено.</p>
        <p class="form-success" data-feedback-success hidden>Спасибо, сообщение отправлено. Я свяжусь с вами в течение 1 часа.</p>

        <button class="button primary form-submit" type="submit">Отправить</button>
      </form>
    </dialog>

    <script is:inline>
      const dialog = document.getElementById("feedbackDialog");
      const root = document.documentElement;
      const themeToggle = document.querySelector("[data-theme-toggle]");
      const validationErrorText = "Проверьте поля: имя - буквы и пробелы, почта - с @, тема - от 10 символов, согласие - отмечено.";
      const deliveryErrorText = "Не получилось отправить сообщение. Попробуйте еще раз или нажмите «Написать на email».";
      let themeTransitionTimer;

      const applyTheme = (theme, options = {}) => {
        const { animate = false } = options;

        if (animate) {
          root.classList.add("theme-switching");
          window.clearTimeout(themeTransitionTimer);
          themeTransitionTimer = window.setTimeout(() => {
            root.classList.remove("theme-switching");
          }, 460);
        }

        root.dataset.theme = theme;

        try {
          localStorage.setItem("theme", theme);
        } catch {
          // Local storage can be unavailable in private browser modes.
        }

        if (themeToggle) {
          const isLight = theme === "light";
          themeToggle.setAttribute("aria-pressed", String(isLight));
          themeToggle.setAttribute(
            "aria-label",
            isLight ? "Включить темную тему" : "Включить светлую тему",
          );
        }
      };

      applyTheme(root.dataset.theme === "light" ? "light" : "dark");

      themeToggle?.addEventListener("click", () => {
        applyTheme(root.dataset.theme === "light" ? "dark" : "light", { animate: true });
      });

      const mobileDisclosureQuery = window.matchMedia("(max-width: 560px)");
      const mobileDisclosureButtons = Array.from(document.querySelectorAll("[data-mobile-toggle]"));

      const syncMobileDisclosures = () => {
        const isMobile = mobileDisclosureQuery.matches;
        root.classList.toggle("mobile-disclosure-ready", isMobile);

        mobileDisclosureButtons.forEach((button) => {
          const panel = document.getElementById(button.getAttribute("aria-controls") || "");

          if (!panel) {
            return;
          }

          if (isMobile && panel.dataset.mobilePrepared !== "true") {
            panel.classList.remove("is-open");
            panel.dataset.mobilePrepared = "true";
          }

          if (!isMobile) {
            panel.classList.add("is-open");
          }

          const isOpen = panel.classList.contains("is-open");
          const stateLabel = button.querySelector("span:last-child");
          button.setAttribute("aria-expanded", String(isOpen));

          if (stateLabel) {
            stateLabel.textContent = isOpen ? "Скрыть" : "Открыть";
          }
        });
      };

      mobileDisclosureButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const panel = document.getElementById(button.getAttribute("aria-controls") || "");

          if (!panel || !mobileDisclosureQuery.matches) {
            return;
          }

          panel.classList.toggle("is-open");
          const isOpen = panel.classList.contains("is-open");
          const stateLabel = button.querySelector("span:last-child");
          button.setAttribute("aria-expanded", String(isOpen));

          if (stateLabel) {
            stateLabel.textContent = isOpen ? "Скрыть" : "Открыть";
          }
        });
      });

      mobileDisclosureQuery.addEventListener?.("change", syncMobileDisclosures);
      syncMobileDisclosures();

      document.querySelectorAll("[data-feedback-trigger]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          if (dialog && "showModal" in dialog) {
            dialog.showModal();
          }
        });
      });

      document.querySelectorAll("[data-feedback-close]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          dialog?.close();
        });
      });

      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });

      document.querySelectorAll("[data-feedback-form]").forEach((feedbackForm) => {
        const fields = Array.from(feedbackForm.querySelectorAll("input"));
        const formError = feedbackForm.querySelector("[data-feedback-error]");
        const formSuccess = feedbackForm.querySelector("[data-feedback-success]");

        const hideFeedback = () => {
          formError?.setAttribute("hidden", "");
          formSuccess?.setAttribute("hidden", "");
        };

        const showError = (message = validationErrorText) => {
          formSuccess?.setAttribute("hidden", "");
          if (formError) {
            formError.textContent = message;
            formError.removeAttribute("hidden");
          }
        };

        const showSuccess = () => {
          formError?.setAttribute("hidden", "");
          formSuccess?.removeAttribute("hidden");
        };

        hideFeedback();

        fields.forEach((field) => {
          field.addEventListener("input", () => {
            field.classList.remove("is-invalid");
            field.setCustomValidity("");
            hideFeedback();
          });
        });

        feedbackForm.addEventListener("submit", async (event) => {
          event.preventDefault();

          const data = new FormData(feedbackForm);
          const name = String(data.get("name") || "").trim();
          const contact = String(data.get("contact") || "").trim();
          const topic = String(data.get("topic") || "").trim();
          const nameField = feedbackForm.querySelector('input[name="name"]');
          const contactField = feedbackForm.querySelector('input[name="contact"]');
          const topicField = feedbackForm.querySelector('input[name="topic"]');
          const consentField = feedbackForm.querySelector('input[name="consent"]');
          const submitButton = feedbackForm.querySelector('button[type="submit"]');
          const endpoint = feedbackForm.dataset.formEndpoint;
          const nameLetterCount = (name.match(/[A-Za-zА-Яа-яЁё]/gu) || []).length;
          const nameIsValid = /^[A-Za-zА-Яа-яЁё ]+$/u.test(name) && nameLetterCount >= 2;
          const contactIsValid = contact.includes("@");
          const topicIsValid = topic.length >= 10;
          const consentIsValid = consentField?.checked === true;

          fields.forEach((field) => field.classList.remove("is-invalid"));
          hideFeedback();

          nameField?.setCustomValidity(nameIsValid ? "" : "Имя должно содержать только русские или английские буквы, не менее 2 букв.");
          contactField?.setCustomValidity(contactIsValid ? "" : "Почта должна содержать @.");
          topicField?.setCustomValidity(topicIsValid ? "" : "Тема обращения должна быть не короче 10 символов.");
          consentField?.setCustomValidity(consentIsValid ? "" : "Нужно согласие на обработку персональных данных.");

          if (!nameIsValid || !contactIsValid || !topicIsValid || !consentIsValid || !feedbackForm.checkValidity()) {
            fields.forEach((field) => {
              if (!field.checkValidity()) {
                field.classList.add("is-invalid");
              }
            });
            showError();
            return;
          }

          if (!endpoint) {
            showError(deliveryErrorText);
            return;
          }

          fields.forEach((field) => field.classList.remove("is-invalid"));
          nameField?.setCustomValidity("");
          contactField?.setCustomValidity("");
          topicField?.setCustomValidity("");
          consentField?.setCustomValidity("");

          const previousButtonText = submitButton?.textContent || "Отправить";

          if (submitButton) {
            submitButton.textContent = "Отправляется";
            submitButton.disabled = true;
          }

          try {
            const payload = new FormData();
            payload.append("name", name);
            payload.append("email", contact);
            payload.append("message", topic);
            payload.append("consent", "Получено согласие на обработку персональных данных");
            payload.append("_subject", `Обращение с сайта: ${topic}`);
            payload.append("_captcha", "false");
            payload.append("_template", "table");

            const response = await fetch(endpoint, {
              method: "POST",
              headers: {
                Accept: "application/json",
              },
              body: payload,
            });

            if (!response.ok) {
              throw new Error("Form service rejected the submission");
            }

            showSuccess();
            feedbackForm.reset();

            window.setTimeout(() => {
              feedbackForm.closest("dialog")?.close();
            }, 900);
          } catch {
            showError(deliveryErrorText);
          } finally {
            if (submitButton) {
              submitButton.textContent = previousButtonText;
              submitButton.disabled = false;
            }
          }
        });
      });
    </script>
  </body>
</html>
