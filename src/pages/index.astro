---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import "../styles/global.css";
import { profile } from "../data/profile";
import portrait from "../../public/images/dmitry-fadeev-editorial.png";
import projectAbstract1 from "../../public/images/figma/project-abstract-1.png";
import projectAbstract2 from "../../public/images/figma/project-abstract-2.png";
import projectAbstract3 from "../../public/images/figma/project-abstract-3.png";
import projectAbstract4 from "../../public/images/figma/project-abstract-4.png";

const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const projectVisuals = [projectAbstract1, projectAbstract2, projectAbstract3, projectAbstract4];
const projectByTitle = (title: string) => projects.find((project) => project.data.title === title);
const experienceByCompany = (company: string) => experience.find((item) => item.data.company === company);
const widProject = projectByTitle("WID");
const pixelProject = projectByTitle("Pixel Runner");
const w3promoExperience = experienceByCompany("W3Promo");
const roviExperience = experienceByCompany("ROVI Factoring Plus / Delta Leasing");
const keyCases = [
  {
    title: "WID",
    context: "Product / fashion-tech",
    contribution: "Требования, бэклог, Kanban, зависимости и согласования внутри продукта.",
    href: widProject?.data.titleHref,
    image: projectVisuals[0],
  },
  {
    title: "W3Promo",
    context: "Digital-проекты",
    contribution: "До 10 проектов, подрядчики, сроки, бюджеты, сметы и проектная документация.",
    href: w3promoExperience?.data.url,
    image: projectVisuals[1],
  },
  {
    title: "Pixel Runner",
    context: "Game dev",
    contribution: "Механика, лидерборд, античит, интеграции, ТЗ и критерии приемки.",
    href: pixelProject?.data.titleHref,
    image: projectVisuals[2],
  },
];
const artifactCards = [
  {
    title: "Roadmap / Risk map",
    text: "Этапы, сроки, точки контроля и риски проекта.",
    href: profile.artifacts.featuredGroups[0]?.links[0]?.href,
    variant: "roadmap",
  },
  {
    title: "Backlog",
    text: "Задачи, приоритеты и границы работ.",
    href: profile.artifacts.featuredGroups[1]?.links[0]?.href,
    variant: "backlog",
  },
  {
    title: "QA checklist",
    text: "Критерии приемки и контроль качества.",
    href: profile.artifacts.featuredGroups[0]?.links[0]?.href,
    variant: "qa",
  },
  {
    title: "ТЗ / структура страниц",
    text: "Технический контур и передача задач в разработку.",
    href: profile.artifacts.featuredGroups[2]?.links[0]?.href,
    variant: "spec",
  },
];
const keepShortWords = (value: string) =>
  value.replace(/(^|\s)([A-Za-zА-Яа-яЁё]{1,2})\s+(?=\S)/gu, "$1$2\u00A0");
const cooperationSubject = encodeURIComponent("Предложение сотрудничества");
const contactFormEndpoint = `https://formsubmit.co/ajax/${profile.email}`;
const basePath = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const privacyUrl = `${basePath}privacy/`;
const consentUrl = `${basePath}consent/`;
const diplomaUrl = `${basePath}${profile.education.diplomaUrl.replace(/^\//, "")}`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Дмитрий Фадеев, Project Manager IT-проектов: требования, сроки, команда, бриф, аналитика, бэклог, риски, ТЗ, приемка, статусы."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{profile.name} - {profile.role}</title>
    <script is:inline>
      (() => {
        try {
          if (localStorage.getItem("theme") === "light") {
            document.documentElement.dataset.theme = "light";
          }
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body class="figma-remake">
    <header class="site-header">
      <a class="brand" href="#top">
        <span class="brand-full">Dmitriy Web</span>
        <span class="brand-short" aria-hidden="true">ДФ</span>
      </a>
      <nav class="nav" aria-label="Основная навигация">
        <a href="#top" aria-label="Главная"><span class="nav-label">Главная</span><span class="nav-icon" aria-hidden="true">Главная</span></a>
        <a href="#about" aria-label="Обо мне"><span class="nav-label">Обо мне</span><span class="nav-icon" aria-hidden="true">Обо мне</span></a>
        <a href="#projects" aria-label="Кейсы"><span class="nav-label">Кейсы</span><span class="nav-icon" aria-hidden="true">Кейсы</span></a>
        <a href="#artifacts" aria-label="Артефакты"><span class="nav-label">Артефакты</span><span class="nav-icon" aria-hidden="true">Артефакты</span></a>
        <a href="#contact" aria-label="Контакты"><span class="nav-label">Контакты</span><span class="nav-icon" aria-hidden="true">Контакты</span></a>
      </nav>
      <button class="theme-action" type="button" data-theme-toggle aria-label="Включить светлую тему" aria-pressed="false">
        <span class="theme-icon theme-icon-light" aria-hidden="true">☾</span>
        <span class="theme-icon theme-icon-dark" aria-hidden="true">✹</span>
      </button>
      <button class="menu-action" type="button" data-menu-toggle aria-label="Открыть меню" aria-expanded="false" aria-controls="mobileMenu">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
      <nav class="mobile-menu" id="mobileMenu" data-mobile-menu aria-label="Мобильная навигация">
        <a href="#top">Главная</a>
        <a href="#about">Обо мне</a>
        <a href="#projects">Кейсы</a>
        <a href="#artifacts">Артефакты</a>
        <a href="#contact">Контакты</a>
      </nav>
    </header>

    <main id="top" class="figma-page">
      <section class="figma-hero" aria-labelledby="hero-title">
        <p class="figma-kicker">{profile.name}</p>
        <h1 id="hero-title">Project Manager IT-проектов</h1>
        <p class="figma-hero-lead">Веду проекты от постановки задач до результата: бюджет, коммуникация, контроль сроков и качества.</p>
        <a class="figma-button figma-button-fill" href="#projects">Посмотреть проекты</a>
      </section>

      <section class="figma-about" id="about" aria-labelledby="about-title">
        <div class="figma-about-copy">
          <p class="figma-kicker">Обо мне</p>
          <h2 id="about-title">Веду проект от вводных до приемки результата</h2>
          <p>{keepShortWords("Фиксирую границы, собираю бэклог, держу статусы, риски, коммуникацию и контроль качества.")}</p>
          <ul class="figma-stats" aria-label="Ключевые цифры">
            {
              profile.heroStats.map((item) => (
                <li>
                  <strong>{item.value}</strong>
                  <span>{item.label}</span>
                </li>
              ))
            }
          </ul>
          <a class="figma-education-note" href={diplomaUrl} target="_blank" rel="noreferrer">
            <span>{profile.education.title}</span>
            <strong>{profile.education.program}</strong>
          </a>
        </div>
        <figure class="figma-portrait" aria-label="Портрет Дмитрия Фадеева">
          <Image
            src={portrait}
            alt="Дмитрий Фадеев"
            widths={[420, 640, 900]}
            sizes="(max-width: 760px) 82vw, 36vw"
            loading="eager"
          />
        </figure>
      </section>

      <section class="figma-projects" id="projects" aria-labelledby="projects-title">
        <div class="figma-section-head">
          <h2 id="projects-title">Ключевые кейсы</h2>
        </div>
        <div class="figma-project-grid">
          {
            keyCases.map((item) => (
              <article class="figma-project-card">
                <a class="figma-project-image" href={item.href ?? "#contact"} target={item.href ? "_blank" : undefined} rel={item.href ? "noreferrer" : undefined} aria-label={`Открыть кейс ${item.title}`}>
                  <Image src={item.image} alt="" widths={[420, 720, 960]} sizes="(max-width: 760px) 88vw, 31vw" loading="lazy" />
                </a>
                <div class="figma-project-title">
                  <h3>
                    {item.href ? (
                      <a href={item.href} target="_blank" rel="noreferrer">{item.title}</a>
                    ) : (
                      item.title
                    )}
                  </h3>
                  <span aria-hidden="true"></span>
                </div>
                <dl>
                  <div>
                    <dt>Контекст:</dt>
                    <dd>{item.context}</dd>
                  </div>
                  <div>
                    <dt>Зона ответственности:</dt>
                    <dd>{item.contribution}</dd>
                  </div>
                </dl>
              </article>
            ))
          }
        </div>
        {roviExperience && (
          <aside class="figma-b2b-proof">
            <span>B2B-опыт</span>
            <p>
              <strong>ROVI Factoring Plus / Delta Leasing</strong>: {keepShortWords("статусы, риски, процессы и коммуникация на стыке сервиса, финансовых продуктов и внутренних команд.")}
            </p>
          </aside>
        )}
      </section>

      <section class="figma-artifacts" id="artifacts" aria-labelledby="artifacts-title">
        <div class="figma-section-head">
          <h2 id="artifacts-title">Проектные артефакты</h2>
        </div>
        <div class="figma-artifact-grid">
          {
            artifactCards.map((card) => (
              <a class="figma-artifact-card" href={card.href ?? profile.artifacts.sourceFolder} target="_blank" rel="noreferrer" aria-label={`Открыть артефакт: ${card.title}`}>
                <span class={`figma-artifact-visual figma-artifact-visual-${card.variant}`} aria-hidden="true">
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
                <strong>{card.title}</strong>
                <span>{keepShortWords(card.text)}</span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="figma-github" id="github" aria-labelledby="github-title">
        <div class="figma-section-head">
          <h2 id="github-title">Мои проекты на GitHub</h2>
        </div>
        <div class="figma-github-grid">
          {
            profile.github.repos.map((repo) => (
              <a href={repo.href} target="_blank" rel="noreferrer" aria-label={`Открыть репозиторий ${repo.name}`}>
                <strong>{repo.name}</strong>
                <span>{keepShortWords(repo.description)}</span>
              </a>
            ))
          }
        </div>
      </section>

      <footer class="figma-contact" id="contact" aria-labelledby="contact-title">
        <div class="figma-contact-head">
          <h2 id="contact-title">Готов обсудить проектную роль</h2>
          <p>Если мой подход подходит вашей команде, напишите удобным способом.</p>
        </div>
        <div class="figma-contact-actions" aria-label="Способы связи">
          <a class="figma-button figma-button-outline" href={`mailto:${profile.email}?subject=${cooperationSubject}`}>Email</a>
          <a class="figma-button figma-button-outline" href={profile.vk} target="_blank" rel="noreferrer">VK</a>
          <button class="figma-button figma-button-outline figma-contact-message-button" type="button" data-feedback-trigger>
            Оставить короткое сообщение
          </button>
        </div>
      </footer>
    </main>

    <dialog class="feedback-dialog" id="feedbackDialog" aria-labelledby="feedbackTitle">
      <form class="feedback-form" id="feedbackForm" method="dialog" data-feedback-form data-form-endpoint={contactFormEndpoint} novalidate>
        <div class="feedback-head">
          <div>
            <p class="eyebrow">Обратная связь</p>
            <h2 id="feedbackTitle">Коротко опишите запрос</h2>
          </div>
          <button class="dialog-close" type="button" data-feedback-close aria-label="Закрыть форму">×</button>
        </div>

          <label>
            <span>Имя</span>
            <input name="name" type="text" autocomplete="name" minlength="2" required placeholder="Как к вам обращаться" />
          </label>

          <label>
            <span>Почта</span>
            <input name="contact" type="email" autocomplete="email" required placeholder="email@example.com" />
          </label>

        <label>
          <span>Тема обращения</span>
          <input name="topic" type="text" minlength="10" required placeholder="Не менее 10 символов" />
        </label>

        <label class="consent-check">
          <input name="consent" type="checkbox" required />
          <span>
            Согласен с <a href={privacyUrl} target="_blank">политикой конфиденциальности</a> и <a href={consentUrl} target="_blank">обработкой персональных данных</a>.
          </span>
        </label>

        <p class="form-error" data-feedback-error hidden>Проверьте поля: имя - буквы и пробелы, почта - с @, тема - от 10 символов, согласие - отмечено.</p>
        <p class="form-success" data-feedback-success hidden>Спасибо, сообщение отправлено. Я свяжусь с вами в течение 1 часа.</p>

        <button class="button primary form-submit" type="submit">Отправить</button>
      </form>
    </dialog>

    <script is:inline>
      const dialog = document.getElementById("feedbackDialog");
      const root = document.documentElement;
      const themeToggle = document.querySelector("[data-theme-toggle]");
      const menuToggle = document.querySelector("[data-menu-toggle]");
      const mobileMenu = document.querySelector("[data-mobile-menu]");
      const validationErrorText = "Проверьте поля: имя - буквы и пробелы, почта - с @, тема - от 10 символов, согласие - отмечено.";
      const deliveryErrorText = "Не получилось отправить сообщение. Попробуйте еще раз или нажмите «Написать на email».";
      let themeTransitionTimer;

      const applyTheme = (theme, options = {}) => {
        const { animate = false } = options;

        if (animate) {
          root.classList.add("theme-switching");
          window.clearTimeout(themeTransitionTimer);
          themeTransitionTimer = window.setTimeout(() => {
            root.classList.remove("theme-switching");
          }, 460);
        }

        root.dataset.theme = theme;

        try {
          localStorage.setItem("theme", theme);
        } catch {
          // Local storage can be unavailable in private browser modes.
        }

        if (themeToggle) {
          const isLight = theme === "light";
          themeToggle.setAttribute("aria-pressed", String(isLight));
          themeToggle.setAttribute(
            "aria-label",
            isLight ? "Включить темную тему" : "Включить светлую тему",
          );
        }
      };

      applyTheme(root.dataset.theme === "light" ? "light" : "dark");

      themeToggle?.addEventListener("click", () => {
        applyTheme(root.dataset.theme === "light" ? "dark" : "light", { animate: true });
      });

      const setMenuState = (isOpen) => {
        mobileMenu?.classList.toggle("is-open", isOpen);
        menuToggle?.classList.toggle("is-open", isOpen);
        menuToggle?.setAttribute("aria-expanded", String(isOpen));
        menuToggle?.setAttribute("aria-label", isOpen ? "Закрыть меню" : "Открыть меню");
      };

      menuToggle?.addEventListener("click", () => {
        setMenuState(!mobileMenu?.classList.contains("is-open"));
      });

      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenuState(false));
      });

      document.addEventListener("click", (event) => {
        if (!mobileMenu?.classList.contains("is-open") || !(event.target instanceof Node)) {
          return;
        }

        if (mobileMenu.contains(event.target) || menuToggle?.contains(event.target)) {
          return;
        }

        setMenuState(false);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          setMenuState(false);
        }
      });

      const mobileDisclosureQuery = window.matchMedia("(max-width: 560px)");
      const mobileDisclosureButtons = Array.from(document.querySelectorAll("[data-mobile-toggle]"));

      const syncMobileDisclosures = () => {
        const isMobile = mobileDisclosureQuery.matches;
        root.classList.toggle("mobile-disclosure-ready", isMobile);

        mobileDisclosureButtons.forEach((button) => {
          const panel = document.getElementById(button.getAttribute("aria-controls") || "");

          if (!panel) {
            return;
          }

          if (isMobile && panel.dataset.mobilePrepared !== "true") {
            panel.classList.remove("is-open");
            panel.dataset.mobilePrepared = "true";
          }

          if (!isMobile) {
            panel.classList.add("is-open");
          }

          const isOpen = panel.classList.contains("is-open");
          const stateLabel = button.querySelector("span:last-child");
          button.setAttribute("aria-expanded", String(isOpen));

          if (stateLabel) {
            stateLabel.textContent = isOpen ? "Скрыть" : "Открыть";
          }
        });
      };

      mobileDisclosureButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const panel = document.getElementById(button.getAttribute("aria-controls") || "");

          if (!panel || !mobileDisclosureQuery.matches) {
            return;
          }

          panel.classList.toggle("is-open");
          const isOpen = panel.classList.contains("is-open");
          const stateLabel = button.querySelector("span:last-child");
          button.setAttribute("aria-expanded", String(isOpen));

          if (stateLabel) {
            stateLabel.textContent = isOpen ? "Скрыть" : "Открыть";
          }
        });
      });

      mobileDisclosureQuery.addEventListener?.("change", syncMobileDisclosures);
      syncMobileDisclosures();

      document.querySelectorAll("[data-feedback-trigger]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          if (dialog && "showModal" in dialog) {
            dialog.showModal();
          }
        });
      });

      document.querySelectorAll("[data-feedback-close]").forEach((trigger) => {
        trigger.addEventListener("click", () => {
          dialog?.close();
        });
      });

      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) {
          dialog.close();
        }
      });

      document.querySelectorAll("[data-feedback-form]").forEach((feedbackForm) => {
        const fields = Array.from(feedbackForm.querySelectorAll("input"));
        const formError = feedbackForm.querySelector("[data-feedback-error]");
        const formSuccess = feedbackForm.querySelector("[data-feedback-success]");

        const hideFeedback = () => {
          formError?.setAttribute("hidden", "");
          formSuccess?.setAttribute("hidden", "");
        };

        const showError = (message = validationErrorText) => {
          formSuccess?.setAttribute("hidden", "");
          if (formError) {
            formError.textContent = message;
            formError.removeAttribute("hidden");
          }
        };

        const showSuccess = () => {
          formError?.setAttribute("hidden", "");
          formSuccess?.removeAttribute("hidden");
        };

        hideFeedback();

        fields.forEach((field) => {
          field.addEventListener("input", () => {
            field.classList.remove("is-invalid");
            field.setCustomValidity("");
            hideFeedback();
          });
        });

        feedbackForm.addEventListener("submit", async (event) => {
          event.preventDefault();

          const data = new FormData(feedbackForm);
          const name = String(data.get("name") || "").trim();
          const contact = String(data.get("contact") || "").trim();
          const topic = String(data.get("topic") || "").trim();
          const nameField = feedbackForm.querySelector('input[name="name"]');
          const contactField = feedbackForm.querySelector('input[name="contact"]');
          const topicField = feedbackForm.querySelector('input[name="topic"]');
          const consentField = feedbackForm.querySelector('input[name="consent"]');
          const submitButton = feedbackForm.querySelector('button[type="submit"]');
          const endpoint = feedbackForm.dataset.formEndpoint;
          const nameLetterCount = (name.match(/[A-Za-zА-Яа-яЁё]/gu) || []).length;
          const nameIsValid = /^[A-Za-zА-Яа-яЁё ]+$/u.test(name) && nameLetterCount >= 2;
          const contactIsValid = contact.includes("@");
          const topicIsValid = topic.length >= 10;
          const consentIsValid = consentField?.checked === true;

          fields.forEach((field) => field.classList.remove("is-invalid"));
          hideFeedback();

          nameField?.setCustomValidity(nameIsValid ? "" : "Имя должно содержать только русские или английские буквы, не менее 2 букв.");
          contactField?.setCustomValidity(contactIsValid ? "" : "Почта должна содержать @.");
          topicField?.setCustomValidity(topicIsValid ? "" : "Тема обращения должна быть не короче 10 символов.");
          consentField?.setCustomValidity(consentIsValid ? "" : "Нужно согласие на обработку персональных данных.");

          if (!nameIsValid || !contactIsValid || !topicIsValid || !consentIsValid || !feedbackForm.checkValidity()) {
            fields.forEach((field) => {
              if (!field.checkValidity()) {
                field.classList.add("is-invalid");
              }
            });
            showError();
            return;
          }

          if (!endpoint) {
            showError(deliveryErrorText);
            return;
          }

          fields.forEach((field) => field.classList.remove("is-invalid"));
          nameField?.setCustomValidity("");
          contactField?.setCustomValidity("");
          topicField?.setCustomValidity("");
          consentField?.setCustomValidity("");

          const previousButtonText = submitButton?.textContent || "Отправить";

          if (submitButton) {
            submitButton.textContent = "Отправляется";
            submitButton.disabled = true;
          }

          try {
            const payload = new FormData();
            payload.append("name", name);
            payload.append("email", contact);
            payload.append("message", topic);
            payload.append("consent", "Получено согласие на обработку персональных данных");
            payload.append("_subject", `Обращение с сайта: ${topic}`);
            payload.append("_captcha", "false");
            payload.append("_template", "table");

            const response = await fetch(endpoint, {
              method: "POST",
              headers: {
                Accept: "application/json",
              },
              body: payload,
            });

            if (!response.ok) {
              throw new Error("Form service rejected the submission");
            }

            showSuccess();
            feedbackForm.reset();

            window.setTimeout(() => {
              feedbackForm.closest("dialog")?.close();
            }, 900);
          } catch {
            showError(deliveryErrorText);
          } finally {
            if (submitButton) {
              submitButton.textContent = previousButtonText;
              submitButton.disabled = false;
            }
          }
        });
      });
    </script>
  </body>
</html>
